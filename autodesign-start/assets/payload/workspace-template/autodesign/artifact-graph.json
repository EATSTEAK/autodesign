      "reconcile": {
        "policy": "may-change",
        "preserve": [
          "approvedFlows",
          "manualAnnotations"
        ],
        "mayChange": [
          "states",
          "transitions",
          "edgeCases"
        ],
        "notes": "Interaction semantics may change when the screen model changes."
      }
    },
    {
      "id": "visual.reference-set",
      "kind": "visual-reference",
      "path": "autodesign/outputs/visual-references",
