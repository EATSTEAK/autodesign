      "referenceOnly": false,
      "required": true,
      "upstreamDependencies": [
        "canonical.requirements"
      ],
      "reconcile": {
        "policy": "may-change",
        "preserve": [
          "approvedScreens",
          "manualAnnotations"
        ],
        "mayChange": [
          "screens",
          "navigation",
          "contentInventory"
        ],
        "notes": "Screen model changes follow requirements changes."
      }
    },
    {
      "id": "canonical.interaction-model",
      "kind": "canonical",
      "path": "autodesign/outputs/canonical/interaction-model.json",
