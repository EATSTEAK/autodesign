        "mayChange": [
          "referenceImages",
          "compositionTargets",
          "styleExplorations"
        ],
        "notes": "Visual references are downstream targets only; Stage 04 does not generate them."
      }
    },
    {
      "id": "pencil.workspace",
      "kind": "pencil",
      "path": "autodesign/outputs/pencil",
      "sourceOfTruth": false,
      "generated": false,
