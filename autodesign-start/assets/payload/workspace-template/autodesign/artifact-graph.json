    },
    {
      "id": "handoff.package",
      "kind": "handoff",
      "path": "autodesign/outputs/handoff",
      "sourceOfTruth": false,
      "generated": false,
      "referenceOnly": true,
      "required": false,
      "upstreamDependencies": [
        "canonical.project-brief",
        "canonical.requirements",
        "canonical.screen-model",
        "canonical.interaction-model",
        "visual.reference-set",
        "pencil.workspace",
        "design-system.tokens"
      ],
      "reconcile": {
        "policy": "may-change",
        "preserve": [
          "handoffApprovals",
          "manualReleaseNotes"
        ],
        "mayChange": [
          "exportedArtifacts",
          "deliveryChecklist"
        ],
        "notes": "Handoff package is a downstream target only in Stage 04."
      }
