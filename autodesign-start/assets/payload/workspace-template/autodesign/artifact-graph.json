      "reconcile": {
        "policy": "may-change",
        "preserve": [
          "manualPencilEdits",
          "approvedFrames",
          "componentNames"
        ],
        "mayChange": [
          "layoutGeometry",
          "frameStructure",
          "visualBindings"
        ],
        "notes": "Pencil workspace metadata is a downstream target only in Stage 04."
      }
    },
    {
      "id": "design-system.tokens",
      "kind": "design-system",
      "path": "autodesign/outputs/design-system/tokens.json",
      "sourceOfTruth": false,
      "generated": false,
      "referenceOnly": true,
      "required": false,
      "upstreamDependencies": [
        "canonical.screen-model",
        "visual.reference-set",
        "pencil.workspace"
