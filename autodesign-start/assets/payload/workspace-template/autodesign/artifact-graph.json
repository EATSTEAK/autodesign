{
  "schemaVersion": 1,
  "stage": "04-manifest-and-artifact-graph",
  "graphId": "autodesign-default-artifact-graph",
  "artifacts": [
    {
      "id": "inputs.project-material",
      "kind": "input",
      "path": "autodesign/inputs",
      "sourceOfTruth": false,
      "generated": false,
      "referenceOnly": false,
      "required": true,
      "upstreamDependencies": [],
      "reconcile": {
        "policy": "preserve",
        "preserve": [
          "userFiles",
          "sourceNotes"
        ],
        "mayChange": [],
        "notes": "User-provided source material is preserved."
      }
    },
    {
      "id": "canonical.project-brief",
      "kind": "canonical",
      "path": "autodesign/outputs/canonical/project-brief.json",
      "sourceOfTruth": true,
      "generated": false,
      "referenceOnly": false,
      "required": true,
      "upstreamDependencies": [
        "inputs.project-material"
      ],
      "reconcile": {
        "policy": "may-change",
        "preserve": [
          "approvedDecisions",
          "manualAnnotations"
        ],
        "mayChange": [
          "summary",
          "constraints",
          "openQuestions"
        ],
        "notes": "Project-brief content may change when source inputs change, while explicit approvals are preserved."
      }
    },
    {
      "id": "canonical.requirements",
      "kind": "canonical",
      "path": "autodesign/outputs/canonical/requirements.json",
      "sourceOfTruth": true,
      "generated": false,
      "referenceOnly": false,
      "required": true,
      "upstreamDependencies": [
        "canonical.project-brief"
      ],
      "reconcile": {
        "policy": "may-change",
        "preserve": [
          "acceptedRequirements",
          "manualAnnotations"
        ],
        "mayChange": [
          "functionalRequirements",
          "nonFunctionalRequirements",
          "priorityNotes"
        ],
        "notes": "Requirements may be recomputed from the approved project brief in later stages."
      }
    },
    {
      "id": "canonical.screen-model",
      "kind": "canonical",
      "path": "autodesign/outputs/canonical/screen-model.json",
