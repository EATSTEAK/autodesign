{
  "schemaVersion": 1,
  "stage": "03-bootstrap-runtime",
  "publicSkills": [
    "autodesign-start"
  ],
  "payloadRoot": "autodesign-start/assets/payload",
  "runtimeImplemented": true,
  "entrypoints": [
    {
      "name": "bootstrap-plan",
      "command": "node autodesign-start/assets/payload/scripts/bootstrap.mjs --target <workspace> --plan",
      "writesFiles": false
    },
    {
      "name": "bootstrap-apply",
      "command": "node autodesign-start/assets/payload/scripts/bootstrap.mjs --target <workspace> --apply --approve-bootstrap",
      "writesFiles": true,
      "requiresApproval": [
        "--approve-bootstrap"
      ]
    },
    {
      "name": "bootstrap-apply-with-overwrite",
      "command": "node autodesign-start/assets/payload/scripts/bootstrap.mjs --target <workspace> --apply --approve-bootstrap --approve-overwrite",
      "writesFiles": true,
      "requiresApproval": [
        "--approve-bootstrap",
        "--approve-overwrite"
      ]
    }
  ],
  "payload": {
    "subskills": [
      {
        "path": "subskills/autodesign-bootstrap-runtime/SKILL.md",
        "status": "no-op-placeholder",
        "purpose": "Private bootstrap runtime boundary documentation."
      },
      {
        "path": "subskills/autodesign-phase-placeholder/SKILL.md",
        "status": "no-op-placeholder",
        "purpose": "Private placeholder for later Autodesign phase subskills."
      }
    ],
    "scripts": [
      {
        "path": "scripts/bootstrap.mjs",
        "status": "implemented",
        "purpose": "Deterministic plan/apply materialization of workspace-template."
      }
    ],
    "hooks": [
      {
        "path": "hooks/autodesign-bootstrap-noop.mjs",
        "status": "no-op-placeholder",
        "purpose": "Bundled no-op hook adapter."
      }
    ],
    "workspaceTemplate": [
      "workspace-template/AGENTS.md",
      "workspace-template/.codex/config.toml",
      "workspace-template/.codex/hooks/autodesign-bootstrap-noop.mjs",
      "workspace-template/.codex/hooks/autodesign-boundary-noop.mjs",
      "workspace-template/autodesign/README.md",
      "workspace-template/autodesign/.system/install-state.json",
      "workspace-template/autodesign/inputs/README.md",
      "workspace-template/autodesign/outputs/README.md",
      "workspace-template/autodesign/logs/README.md"
    ]
  },
  "approvalGates": {
    "planBeforeApply": true,
    "applyRequires": [
      "--approve-bootstrap"
    ],
    "overwriteRequires": [
      "--approve-overwrite"
    ]
  },
  "disabledBehaviors": {
    "canonicalGeneration": true,
    "imageGeneration": true,
    "pencilOperations": true,
    "visualReferenceGeneration": true,
    "designSystemGeneration": true,
    "handoff": true,
    "realSubskillPhaseBehavior": true
  },
  "notes": [
    "autodesign-start is the only public skill at install time.",
    "Stage 03 only materializes bootstrap workspace files.",
    "No canonical generation, image generation, Pencil operation, or real phase behavior is implemented."
  ]
}
