    "scripts": [
      {
        "path": "scripts/generate-canonical.mjs",
        "status": "implemented",
        "purpose": "Deterministic Stage 06 canonical artifact generator and manifest/graph state updater."
      },
      {
        "path": "scripts/bootstrap.mjs",
        "status": "implemented",
        "purpose": "Deterministic plan/apply materialization of workspace-template."
      },
      {
        "path": "scripts/lib/autodesign-state.mjs",
        "status": "implemented",
        "purpose": "Shared deterministic validation, graph traversal, dirty computation, and gate-record helpers."
      },
      {
        "path": "scripts/validate-state.mjs",
        "status": "implemented",
        "purpose": "Validate manifest and artifact graph JSON plus Stage 06 semantic constraints."
      },
      {
        "path": "scripts/check-dependencies.mjs",
        "status": "implemented",
        "purpose": "Check upstream dependency references and graph cycles."
      },
      {
        "path": "scripts/can-run-subskill.mjs",
        "status": "implemented",
        "purpose": "Check whether a named private subskill contract can be entered from manifest and artifact graph state."
      },
      {
        "path": "scripts/dirty-artifacts.mjs",
        "status": "implemented",
        "purpose": "Compute dirty downstream artifacts from changed upstream ids with reconcile metadata."
      },
      {
        "path": "scripts/record-gate.mjs",
        "status": "implemented",
        "purpose": "Record approval gate status in manifest with explicit write approval."
      }
    ],
    "hooks": [
      {
        "path": "hooks/autodesign-bootstrap-noop.mjs",
        "status": "no-op-placeholder",
        "purpose": "Bundled no-op hook adapter."
      }
    ],
    "workspaceTemplate": [
      "workspace-template/AGENTS.md",
      "workspace-template/.codex/config.toml",
      "workspace-template/.codex/hooks/autodesign-bootstrap-noop.mjs",
      "workspace-template/.codex/hooks/autodesign-boundary-noop.mjs",
      "workspace-template/autodesign/README.md",
      "workspace-template/autodesign/manifest.json",
      "workspace-template/autodesign/artifact-graph.json",
      "workspace-template/autodesign/.system/install-state.json",
      "workspace-template/autodesign/inputs/README.md",
      "workspace-template/autodesign/outputs/README.md",
      "workspace-template/autodesign/logs/README.md"
    ]
  },
  "approvalGates": {
    "planBeforeApply": true,
    "applyRequires": [
      "--approve-bootstrap"
    ],
    "overwriteRequires": [
      "--approve-overwrite"
    ],
    "recordGateRequires": [
      "--approve-record"
    ],
    "canonicalGenerationRequires": [
      "--approve-canonical-generation",
      "--actor",
      "--at"
    ]
  },
  "disabledBehaviors": {
    "canonicalGeneration": false,
    "imageGeneration": true,
    "pencilOperations": true,
    "visualReferenceGeneration": true,
    "designSystemGeneration": true,
    "prototypeGeneration": true,
    "handoff": true,
    "realSubskillPhaseBehavior": true
  },
  "notes": [
    "autodesign-start is the only public skill at install time.",
    "Stage 06 implements deterministic canonical generation from real project input files.",
    "Primary visual anchor proposals are planning-only and are not auto-approved.",
    "No image generation, Pencil operation, visual reference generation, design-system work, prototype generation, handoff, reconcile report generation, eval report generation, skill optimization, or downstream phase behavior is implemented."
  ]
}
