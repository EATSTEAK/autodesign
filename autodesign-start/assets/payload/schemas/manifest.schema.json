{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eatsteak.github.io/autodesign/schemas/manifest.schema.json",
  "title": "Autodesign Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "package",
    "publicSkill",
    "workspace",
    "artifactGraph",
    "subskillContracts",
    "approvalGates",
    "approvalRecords",
    "disabledBehaviors",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "string",
      "minLength": 1
    },
    "publicSkill": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "manifestPath",
        "artifactGraphPath"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "manifestPath": {
          "type": "string",
          "minLength": 1
        },
        "artifactGraphPath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifactGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "sourceOfTruth",
        "referencesOnly"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "sourceOfTruth": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "referencesOnly": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "approvalGates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approvalGate"
      }
    },
    "subskillContracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subskillContract"
      }
    },
    "approvalRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approvalRecord"
      }
    },
    "disabledBehaviors": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "subskillContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "status",
        "contractOnly",
        "implemented",
        "requiredUpstreamArtifacts",
        "outputArtifacts",
        "outputFiles",
        "hardGates",
        "disabledBehaviors",
        "failFast"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "contract-only"
        },
        "contractOnly": {
          "const": true
        },
        "implemented": {
          "const": false
        },
        "requiredUpstreamArtifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outputArtifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outputFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "hardGates": {
          "type": "array",
          "items": {
            "enum": [
              "state.valid",
              "graph.dependencies.valid",
              "upstream-artifacts.exist",
              "output-artifacts.declared",
              "disabled-behaviors.enforced",
              "no-real-phase-behavior"
            ]
          },
          "uniqueItems": true
        },
        "disabledBehaviors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "failFast": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "approvalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "required",
        "implemented",
        "scope",
        "requires",
        "updatedAt",
        "actor",
        "note",
        "history"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "blocked",
            "not-implemented"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "implemented": {
          "type": "boolean"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gateId",
        "status",
        "actor",
        "at",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^approval\\.[a-f0-9]{16}$"
        },
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "blocked",
            "not-implemented"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
